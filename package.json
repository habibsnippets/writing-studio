{
  "name": "writing-studio",
  "version": "1.0.0",
  "description": "A local-first writing studio for Markdown, diagrams, PDF annotation, private notes, and GitHub Pages publishing.",
  "keywords": [
    "writing",
    "markdown",
    "blog",
    "diagrams",
    "pdf",
    "local-first",
    "github-pages",
    "katex"
  ],
  "type": "module",
  "main": "server.mjs",
  "bin": {
    "writing-studio": "bin/writing-studio.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "public/",
    "content.example/",
    "docs/",
    "server.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "writing-studio": "node server.mjs",
    "build": "node lib/builder.mjs",
    "check": "node --check server.mjs && node --check bin/writing-studio.mjs && node --check public/studio.js && node --check public/canvas.js && node --check public/main.js",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run check && npm run smoke"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habibsnippets/writing-studio.git"
  },
  "homepage": "https://github.com/habibsnippets/writing-studio#readme",
  "bugs": {
    "url": "https://github.com/habibsnippets/writing-studio/issues"
  },
  "author": "habibsnippets",
  "license": "MIT",
  "dependencies": {
    "katex": "^0.16.47",
    "marked": "^15.0.12",
    "pdfjs-dist": "^6.4.299"
  }
}
