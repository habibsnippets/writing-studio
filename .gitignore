# ---------------------------------------------------------------------------
# Your writing, private notes, and generated site are local-only.
# They are deliberately ignored so a normal `git add .` never publishes them.
# ---------------------------------------------------------------------------
content/
data/
dist/

# Personal working notes gathered while building the studio.
research_notes/

# The engineering masterclass is personal study material, not for publishing.
docs/engineering-guide.md

# First-run starter content (safe to publish). Keep this exception even though
# the live content/ folder above is ignored.
!content.example/

# Dependencies and package-manager logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Secrets and local configuration
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.crt
secrets/
credentials/
*.sqlite
*.sqlite3
*.db

# Local uploads, caches, and temporary files
.cache/
.tmp/
tmp/
uploads/
*.local
*.bak

# npm packaging artefacts and agent/tool metadata
*.tgz
.freebuff/

# Desktop installers built by electron-builder (`npm run dist`)
dist-app/

# Editor and operating-system clutter
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# API keys / provider credentials (AI keys are stored in the browser's
# localStorage, never in the repo, but ignore any file that could hold them).
*.apikey
*api-key*
*api_key*
*apikeys*
ai-config*.json
ai-keys*.json
.ai-config*
.groq*
.gemini*
.openai*
.anthropic*
.vercel
.env*
